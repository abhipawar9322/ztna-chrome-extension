{
  "manifest_version": 3,
  "name": "AI-Powered ZTNA Agent",
  "short_name": "ZTNA Agent",
  "version": "1.0.0",
  "description": "AI-Powered Zero Trust Network Access Client: Device Posture, Real-time Risk Engine, and Adaptive Access Control.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "AI-Powered ZTNA Endpoint Agent",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "options_page": "dashboard/dashboard.html",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "activeTab",
    "notifications",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "pages/*",
        "mock_resources/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
